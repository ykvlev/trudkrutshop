# Скопируйте в .env и подставьте свои значения.

DATABASE_URL="postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5433/tksh_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5433/tksh_shadow?schema=public"
TEST_DATABASE_URL="postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5433/tksh_test?schema=public"

# Интеграции. Пока ключи не заданы — используется mock-реализация провайдера
# (см. src/integrations/*). Реальный провайдер включается наличием ключа.
TOCHKA_API_KEY=""        # эквайринг + облачная касса Точки (оплата, чеки 54-ФЗ)
SAFEROUTE_API_KEY=""     # расчёт и оформление доставки SafeRoute
DIADOC_API_KEY=""        # ЭДО-оператор для УПД (иначе ручной PDF)
DADATA_TOKEN=""          # реквизиты юрлица по ИНН, подсказки адресов

# ── Docker Compose (docker-compose.yml) ────────────────────────────────
# Используются только при запуске всего стека в контейнерах.
POSTGRES_USER="tksh"
POSTGRES_PASSWORD="СМЕНИТЕ_МЕНЯ"   # обязателен, иначе compose не стартует
POSTGRES_DB="tksh"
SITE_ADDRESS=":80"                  # продакшен: trudkrutshop.ru (Caddy выпустит TLS)
