# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# extracted design-system bundles (used assets copied to public/brand and src/app/_fonts)
/_dsx/
/_rso_ds/
/_fontstage/

# local install log
.install.log

# archives (sources kept extracted)
*.zip

# duplicate contract copy (canonical: docs/contract)
/docs/Договорной пакет ТрудКрутШоп/

# python caches
__pycache__/

# claude local settings (personal)
.claude/settings.local.json
